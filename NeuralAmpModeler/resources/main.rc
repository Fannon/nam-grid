// Windows resources: version information and the embedded editor font, plus the
// window, menu and audio preferences of the standalone app (APP_API only).
#include "winres.h"
#include "..\config.h"
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUG_VERSION_RC
 PRODUCTVERSION PLUG_VERSION_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
#ifdef APP_API
 FILETYPE 0x1L
#else
 FILETYPE 0x2L
#endif
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "FileVersion", PLUG_VERSION_STR
            VALUE "ProductVersion", PLUG_VERSION_STR
            VALUE "FileDescription", PLUG_NAME
            VALUE "InternalName", PLUG_NAME
            VALUE "ProductName", PLUG_NAME
            VALUE "CompanyName", PLUG_MFR
            VALUE "LegalCopyright", PLUG_COPYRIGHT_STR
            VALUE "LegalTrademarks", "VST is a registered trademark of Steinberg Media Technologies GmbH."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

ROBOTO_FN TTF ROBOTO_FN

#ifdef APP_API
IDD_DIALOG_PREF DIALOG 0, 0, 223, 309
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Audio Settings"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,110,285,50,14
    PUSHBUTTON      "Apply",IDAPPLY,54,285,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,166,285,50,14
    GROUPBOX        "Audio Device",IDC_STATIC,5,10,210,170
    LTEXT           "Driver Type",IDC_STATIC,20,25,38,8
    COMBOBOX        IDC_COMBO_AUDIO_DRIVER,20,35,100,100,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Buffer Size",IDC_STATIC,135,25,46,8
    COMBOBOX        IDC_COMBO_AUDIO_BUF_SIZE,135,35,65,100,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Input Device",IDC_STATIC,20,55,42,8
    COMBOBOX        IDC_COMBO_AUDIO_IN_DEV,20,65,180,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Output Device",IDC_STATIC,20,85,47,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_DEV,20,95,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Sample Rate",IDC_STATIC,135,85,47,8
    COMBOBOX        IDC_COMBO_AUDIO_SR,135,95,65,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Input L",IDC_STATIC,20,115,40,8
    COMBOBOX        IDC_COMBO_AUDIO_IN_L,20,125,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Input R",IDC_STATIC,65,115,40,8
    COMBOBOX        IDC_COMBO_AUDIO_IN_R,65,125,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Output L",IDC_STATIC,20,145,40,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_L,20,155,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Output R",IDC_STATIC,65,145,40,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_R,65,155,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Mono guitar: same input on L and R",IDC_STATIC,112,127,100,8
    PUSHBUTTON      "Driver Panel...",IDC_BUTTON_OS_DEV_SETTINGS,135,155,65,14
    GROUPBOX        "MIDI Device",IDC_STATIC,5,190,210,85
    LTEXT           "Input Device",IDC_STATIC,15,210,42,8
    COMBOBOX        IDC_COMBO_MIDI_IN_DEV,15,220,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Input Channel",IDC_STATIC,125,210,45,8
    COMBOBOX        IDC_COMBO_MIDI_IN_CHAN,125,220,50,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Output Device",IDC_STATIC,15,240,47,8
    COMBOBOX        IDC_COMBO_MIDI_OUT_DEV,15,250,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
    LTEXT           "Output Channel",IDC_STATIC,125,240,50,8
    COMBOBOX        IDC_COMBO_MIDI_OUT_CHAN,125,250,50,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL
END

IDD_DIALOG_MAIN DIALOG 0, 0, 300, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION PLUG_NAME
MENU IDR_MENU1
FONT 8, "MS Sans Serif"
BEGIN
END

IDR_MENU1 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Audio Settings...	Ctrl+,",  ID_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "&Quit",                       ID_QUIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      ID_ABOUT
        MENUITEM "&Read Manual",                ID_HELP
    END
END

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_OEM_COMMA,   ID_PREFERENCES,         VIRTKEY, CONTROL, NOINVERT
END
#endif
