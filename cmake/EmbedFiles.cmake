# Writes a C++ source that embeds files as byte arrays, without Python or other tools.
#   cmake -DOUTPUT=<file.cpp> -DNAMESPACE=<ns> -DFILES="<symbol>=<path>|..." -P EmbedFiles.cmake
# Each symbol becomes `std::span<const unsigned char> <symbol>()` in the namespace.
set(source "// Generated by cmake/EmbedFiles.cmake; do not edit.\n#include <span>\n\nnamespace ${NAMESPACE}\n{\n")
string(REPLACE "|" ";" entries "${FILES}") # "|" survives command-line quoting; ";" does not.
foreach(entry IN LISTS entries)
  string(REGEX MATCH "^([A-Za-z_][A-Za-z0-9_]*)=(.+)$" matched "${entry}")
  if(NOT matched)
    message(FATAL_ERROR "EmbedFiles: expected symbol=path, got ${entry}")
  endif()
  set(symbol "${CMAKE_MATCH_1}")
  set(path "${CMAKE_MATCH_2}")
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" length)
  math(EXPR bytes "${length} / 2")
  # 0x-prefixed bytes, 32 per line, so no source line gets long.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n  " hex "${hex}")
  string(APPEND source "static const unsigned char ${symbol}Data[${bytes}] = {\n  ${hex}\n};\n"
                       "std::span<const unsigned char> ${symbol}() { return ${symbol}Data; }\n\n")
endforeach()
string(APPEND source "} // namespace ${NAMESPACE}\n")
file(WRITE "${OUTPUT}.tmp" "${source}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
