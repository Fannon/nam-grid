+// Validate before any allocation or typed read. Failed low-level helpers mark
+// the stream so callers cannot accidentally accept a partial or misaligned payload.
+static bool ValidatePayload(std::ifstream& file, int bytes, int alignment)
+{
+  if (!file.good())
+    return false;
+  if (bytes < 0 || alignment <= 0 || bytes % alignment != 0)
+  {
+    file.setstate(std::ios::failbit);
+    return false;
+  }
+  const auto position = file.tellg();
+  if (position == std::streampos(-1))
+    return false;
+  file.seekg(0, std::ios::end);
+  const auto end = file.tellg();
+  if (end == std::streampos(-1) || end < position || end - position < bytes)
+  {
+    file.setstate(std::ios::failbit);
+    return false;
+  }
+  file.seekg(position);
+  return file.good();
+}
