+dsp::wav::LoadReturnCode dsp::wav::LoadIR(const char* fileName, std::vector<float>& left, std::vector<float>& right, double& sampleRate)
+{
+  std::vector<float> interleaved;
+  double rate = 0.;
+  int channels = 0;
+  const auto result = LoadWav(fileName, interleaved, rate, channels, true);
+  if (result != LoadReturnCode::SUCCESS)
+    return result;
+  std::vector<float> decodedLeft, decodedRight;
+  if (channels == 1)
+    decodedLeft.swap(interleaved);
+  else
+  {
+    decodedLeft.resize(interleaved.size() / 2);
+    decodedRight.resize(decodedLeft.size());
+    for (size_t i = 0; i < decodedLeft.size(); ++i)
+    {
+      decodedLeft[i] = interleaved[2 * i];
+      decodedRight[i] = interleaved[2 * i + 1];
+    }
+  }
+  left.swap(decodedLeft);
+  right.swap(decodedRight);
+  sampleRate = rate;
+  return LoadReturnCode::SUCCESS;
 }
 
