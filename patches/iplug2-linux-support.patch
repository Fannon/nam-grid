+bool IGraphicsLinux::RevealPathInExplorerOrFinder(WDL_String& path, bool select)
+{
+  // Open parent directory with xdg-open
+  WDL_String dir(path);
+  if (select)
+  {
+    char* lastSlash = strrchr(dir.Get(), '/');
+    if (lastSlash)
+      *lastSlash = '\0';
+  }
+
+  pid_t pid = fork();
+  if (pid == 0)
+  {
+    execlp("xdg-open", "xdg-open", dir.Get(), nullptr);
+    _exit(127);
+  }
+  return pid > 0;
+}
