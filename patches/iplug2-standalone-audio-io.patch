+#if APP_RESTORE_STATE
+static WDL_String SessionStatePath(const WDL_String& iniPath)
+{
+  WDL_String path(iniPath.Get());
+  path.remove_filepart(true);
+  path.Append("session.state");
+  return path;
+}
+#endif
+
+void IPlugAPPHost::LoadSessionState()
+{
+#if APP_RESTORE_STATE
+  if (IsScreenshotMode() || !mINIPath.GetLength())
+    return;
+
+  FILE* pFile = fopenUTF8(SessionStatePath(mINIPath).Get(), "rb");
+  if (!pFile)
+    return;
+
+  IByteChunk chunk;
+  fseek(pFile, 0, SEEK_END);
+  const long size = ftell(pFile);
+  fseek(pFile, 0, SEEK_SET);
+  const bool read = size > 0 && chunk.Resize(static_cast<int>(size)) == size
+                    && fread(chunk.GetData(), 1, size, pFile) == static_cast<size_t>(size);
+  fclose(pFile);
+
+  if (read && mIPlug->UnserializeState(chunk, 0) >= 0)
+    mIPlug->OnRestoreState();
+#endif
+}
+
+void IPlugAPPHost::SaveSessionState()
+{
+#if APP_RESTORE_STATE
+  if (IsScreenshotMode() || !mINIPath.GetLength())
+    return;
+
+  IByteChunk chunk;
+  if (!mIPlug->SerializeState(chunk) || chunk.Size() <= 0)
+    return;
+
+  // Write a temporary file first so that a failed write keeps the previous session.
+  const WDL_String path = SessionStatePath(mINIPath);
+  WDL_String tempPath(path.Get());
+  tempPath.Append(".tmp");
+  FILE* pFile = fopenUTF8(tempPath.Get(), "wb");
+  if (!pFile)
+    return;
+
+  const bool written = fwrite(chunk.GetData(), 1, chunk.Size(), pFile) == static_cast<size_t>(chunk.Size());
+  if (fclose(pFile) != 0 || !written)
+    return;
+
+#ifdef OS_WIN
+  DeleteFileUTF8(path.Get());
+  MoveFileUTF8(tempPath.Get(), path.Get());
+#else
+  rename(tempPath.Get(), path.Get());
+#endif
+#endif
+}
